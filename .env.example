# ecommerce-ai settings. Copy to .env (never committed) and adjust. No real secret belongs here.

# HTTP server
HOST=127.0.0.1
PORT=8002
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS; empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=

# Access tokens from ecommerce-identity (verified locally against its JWKS)
IDENTITY_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=ecommerce
JWT_CLOCK_TOLERANCE_SECONDS=5

# Platform APIs, always through the gateway
ORDERS_BASE_URL=http://localhost:8090/api/orders
# Inventory catalog (`/products` appended) and Notifications (`/notifications` appended)
INVENTORY_BASE_URL=http://localhost:8090/api/inventory
NOTIFICATIONS_BASE_URL=http://localhost:8090/api
# Orders reads (`order`, `orders` GraphQL queries) used by the MCP tools
ORDERS_GRAPHQL_URL=http://localhost:8090/api/graphql

# JWKS: fetch timeout and minimum gap between refetches on an unknown `kid`
JWKS_TIMEOUT_SECONDS=3
JWKS_REFETCH_COOLDOWN_SECONDS=30

# MCP tools: overall call budget (retries included), upstream body cap, free-text limit
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RESPONSE_BYTES=262144
TOOL_TEXT_MAX_CHARS=500
# Read retries after the first attempt; exponential backoff with full jitter from this base
UPSTREAM_MAX_RETRIES=2
UPSTREAM_BACKOFF_BASE_SECONDS=0.2

# PostgreSQL 16 from ecommerce-infra (host port 5436). Put the user and password in your .env
# (read from the working directory; postgresql:// or postgresql+asyncpg://). Without a user,
# PostgreSQL sees your OS user and the login fails: postgresql://<user>:<password>@localhost:5436/ecommerce_ai
DATABASE_URL=postgresql://localhost:5436/ecommerce_ai

# Connect and statement timeout of PostgreSQL; attempts of one save (first included) and the
# exponential backoff between them (base doubles per retry, capped at max)
DATABASE_TIMEOUT_SECONDS=5
DB_RETRY_MAX_ATTEMPTS=5
DB_RETRY_BACKOFF_BASE_SECONDS=0.5
DB_RETRY_BACKOFF_MAX_SECONDS=10

# Kafka (comma-separated host:port)
KAFKA_BROKERS=localhost:9092
# Triage consumer of orders.order-cancelled, payments.payment-failed, inventory.stock-rejected
TRIAGE_CONSUMER_ENABLED=true
KAFKA_CONSUMER_GROUP=ai-triage
# Reconnect delay after a Kafka failure: doubles per attempt from base, capped at max, with jitter
KAFKA_RECONNECT_BACKOFF_BASE_SECONDS=1
KAFKA_RECONNECT_BACKOFF_MAX_SECONDS=30
# Time the consumer gets to stop when the service shuts down
CONSUMER_SHUTDOWN_TIMEOUT_SECONDS=10

# Triage worker and outbox relay (background tasks; they never block startup)
TRIAGE_WORKER_ENABLED=true
# Quiet time after a case's last event before it is triaged, and the idle poll interval
TRIAGE_SETTLE_SECONDS=3
TRIAGE_POLL_INTERVAL_SECONDS=1
# Delay after a database failure: doubles per attempt from base, capped at max
TRIAGE_BACKOFF_BASE_SECONDS=1
TRIAGE_BACKOFF_MAX_SECONDS=30

# LLM. The model is used only when both ANTHROPIC_MODEL and ANTHROPIC_API_KEY are set; otherwise
# every case gets its deterministic fallback template.
ANTHROPIC_MODEL=claude-opus-5-5
# Timeout of one call, retries after the first attempt, output limit of one call, effort
# (low | medium | high)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_EFFORT=low
# Most tokens one case may spend (>= LLM_MAX_OUTPUT_TOKENS) and the hard cap per UTC day
# (0 disables the LLM)
CASE_TOKEN_CAP=8000
DAILY_TOKEN_BUDGET=50000

# Outbox relay publishing ai.order-triage-completed: attempts before an event is EXHAUSTED,
# retry delay (doubles from base, capped at max, with jitter) and the idle poll interval
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=1
OUTBOX_BACKOFF_MAX_SECONDS=60
OUTBOX_POLL_INTERVAL_SECONDS=1

# Chat assistant (/chat). Tool calls reuse TOOL_TIMEOUT_SECONDS. Keep-alive comment after this much
# stream silence; most tokens one message may spend (>= LLM_MAX_OUTPUT_TOKENS, shares
# DAILY_TOKEN_BUDGET); messages per user per sliding window; model→tool rounds per answer; most
# messages (user + assistant) in one conversation
CHAT_KEEPALIVE_SECONDS=15
CHAT_REQUEST_TOKEN_CAP=20000
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_TOOL_ROUNDS=5
CHAT_MAX_MESSAGES=100

# Approvals (US-06): seconds a proposed cancel_order stays approvable; most cancel proposals one
# user may get per rolling hour (counted from the audit table, survives restarts)
APPROVAL_TTL_SECONDS=600
CANCEL_PROPOSALS_PER_HOUR=5

# Secrets: set real values only in your local .env (git-ignored, excluded from the Docker image).
ANTHROPIC_API_KEY=
# Not read by the service yet; the tracing story adds them.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ecommerce-ai
